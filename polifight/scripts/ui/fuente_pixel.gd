static func calcular_ancho(contenido: String, tamano_pixel: int) -> int:
	if contenido.is_empty():
		return 0
	return (
		contenido.length() * ANCHO_GLIFO
		+ (contenido.length() - 1) * ESPACIO_GLIFO
	) * tamano_pixel


static func dibujar_texto(
	lienzo: CanvasItem,
	contenido: String,
	origen: Vector2,
	tamano_pixel: int,
	color: Color
) -> void:
	var cursor_x := origen.x
	for caracter in contenido:
		if GLIFOS.has(caracter):
			var filas: Array = GLIFOS[caracter]
			for fila in filas.size():
				for columna in ANCHO_GLIFO:
					if filas[fila][columna] == "1":
						lienzo.draw_rect(
							Rect2(
								cursor_x + columna * tamano_pixel,
								origen.y + fila * tamano_pixel,
								tamano_pixel,
								tamano_pixel
							),
							color,
							true
						)
		cursor_x += (ANCHO_GLIFO + ESPACIO_GLIFO) * tamano_pixel
